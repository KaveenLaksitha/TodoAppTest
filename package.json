{
  "name": "daylight-todos",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "check": "npm test && npm run build && npm run format:check",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10"
  }
}
